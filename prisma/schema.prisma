generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // Hashed via bcrypt
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model Post {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  excerpt    String?
  content      String // Tiptap HTML content
  coverImage   String? // Cloudinary URL
  coverPublicId String? // Cloudinary public_id — for deleting the asset
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  authorId   String
  author     Admin    @relation(fields: [authorId], references: [id])
}

model Consultation {
  id        String   @id @default(cuid())
  name      String
  phone     String
  service   String
  message   String?
  status    String   @default("NEW") // NEW, CONTACTED, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Documentation {
  id        String   @id @default(cuid())
  caption   String?
  category  String // kids-growth | tpa | kb | tk | bimbel | paud
  imageUrl  String // Cloudinary secure_url
  publicId  String?  @unique // Cloudinary public_id — for delete + seed idempotency
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, published])
}
