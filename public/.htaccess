# Next.js Reverse Proxy
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # 1. Disable DirectoryIndex so Apache doesn't append /index.html
  DirectoryIndex disabled
  # 2. Only serve real files from public folder (ignore directories)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  # 3. Pass EVERYTHING ELSE (including the / home page) to Next.js
  RewriteRule ^(.*)$ http://127.0.0.1:3355/$1 [P,L]
</IfModule>
